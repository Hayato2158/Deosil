{
  "name": "deosil",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && node scripts/verify-static.mjs && node scripts/test-entry.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply deosil-sessions --local",
    "d1:migrate:remote": "wrangler d1 migrations apply deosil-sessions --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260809.1",
    "typescript": "7.0.2",
    "wrangler": "4.120.0"
  }
}
